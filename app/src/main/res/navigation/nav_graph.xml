<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/mainActivity">

    <activity
        android:id="@+id/mainActivity"
        android:name="com.example.androiduitesting.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
        <action
            android:id="@+id/action_show_to_main"
            app:destination="@id/showActivity">
        </action>
    <fragment
        android:id="@+id/showActivity"
        android:name="com.example.androiduitesting.ShowActivity"
        android:label="ShowActivity" />
        <action
            android:id="@+id/action_main_to_show"
            app:destination="@id/mainActivity">
        </action>
</navigation>